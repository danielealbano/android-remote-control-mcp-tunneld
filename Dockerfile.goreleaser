# Used by goreleaser: it builds the static tunneld binary itself, then this image just copies it in
# (contrast with ./Dockerfile, the self-contained multi-stage build the Compose stack uses locally).
FROM gcr.io/distroless/static:nonroot
ARG TARGETPLATFORM
COPY $TARGETPLATFORM/tunneld /tunneld
COPY THIRD_PARTY_LICENSES.txt /THIRD_PARTY_LICENSES.txt
ENTRYPOINT ["/tunneld", "serve"]
