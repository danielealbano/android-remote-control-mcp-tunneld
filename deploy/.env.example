# Shared compose env (placeholders — real values are private). This file is interpolated by
# docker-compose.yml. It is NOT loaded into the tunneld process (least privilege — see tunneld.env.example
# for tunneld's own TUNNELD_* surface).

# Operator uid (run: id -u) — tunneld runs as this uid so it can read ./ca + ./attest and write ./logs.
DEPLOY_UID=1000

# Domains — SINGLE source of truth (placeholders). The public SNI is <name>.<TUNNEL_DOMAIN>.
TUNNEL_DOMAIN=t.example.test
ENROLL_HOST=enroll.example.test
CONTROL_HOST=connect.example.test

# Durable state (MinIO LOCAL stand-in; production points --s3-endpoint at any plain-S3 provider). These
# feed BOTH MinIO (root creds) and tunneld (the TUNNELD_S_3_* twins, via docker-compose environment).
# PRE-GO-LIVE, validate a real provider with a read-after-write probe (see docs/PROJECT.md).
S3_ACCESS_KEY=changeme
S3_SECRET_KEY=changeme
S3_BUCKET=tunneld

# Ops UIs — published on 127.0.0.1 ONLY (reach via SSH forward).
GRAFANA_ADMIN_PASSWORD=changeme
