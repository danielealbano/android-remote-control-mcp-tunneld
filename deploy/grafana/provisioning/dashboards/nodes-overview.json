     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max by (node) (time() - wireguard_peer_latest_handshake_timestamp_seconds{node=~\"$node\"})",
     "legendFormat": "{{node}}"
