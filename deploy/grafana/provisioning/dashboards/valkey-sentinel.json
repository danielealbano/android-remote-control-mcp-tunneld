  "list": [
   {
    "name": "node",
    "label": "node",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "query": {
     "query": "label_values(up{job=\"valkey\"}, node)",
     "refId": "node"
    },
    "definition": "label_values(up{job=\"valkey\"}, node)",
    "refresh": 1,
    "sort": 1,
    "multi": true,
    "includeAll": true,
    "current": {
     "text": "All",
     "value": "$__all"
    }
   }
  ]
 },
