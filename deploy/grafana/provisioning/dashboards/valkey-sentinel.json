  {
   "id": 2,
   "type": "timeseries",
   "title": "Memory used vs maxmemory",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 1
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "100 * redis_memory_used_bytes{service=\"valkey\",node=~\"$node\"} / redis_memory_max_bytes{service=\"valkey\",node=~\"$node\"}",
     "legendFormat": "{{node}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "custom": {
      "drawStyle": "line",
      "lineWidth": 1,
      "fillOpacity": 10,
      "stacking": {
       "mode": "none"
      },
      "showPoints": "never"
     },
     "min": 0,
     "max": 100
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
