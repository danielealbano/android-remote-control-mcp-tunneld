  {
   "id": 10,
   "type": "timeseries",
   "title": "Enrollments by result",
   "description": "Count per bar (one bar per time step, at least 1 min). A gap of over 1 h in the data is not counted.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 22
   },
   "interval": "1m",
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (result) (sum_over_time(((tunneld_enrollments_total{node=~\"$node\"} - last_over_time(tunneld_enrollments_total{node=~\"$node\"}[1h] offset 15s)) >= 0 or (tunneld_enrollments_total{node=~\"$node\"} < last_over_time(tunneld_enrollments_total{node=~\"$node\"}[1h] offset 15s)) + 0)[$__interval:15s]))",
     "legendFormat": "{{result}}"
