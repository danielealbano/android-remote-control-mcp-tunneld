# tunneld's OWN process environment (copy to tunneld.env; real values are private). Loaded ONLY by the
# tunneld service. Topology + S3 credentials come from docker-compose.yml's `environment:` (sourced from
# .env) and are NOT repeated here. Every value is a kong TUNNELD_* flag twin (note --s3-* → TUNNELD_S_3_*).

# --- Internal CA (the phone earns an identity cert by attested enrollment) ---
TUNNELD_CA_CERT=/ca/ca.pem
TUNNELD_CA_KEY=/ca/ca-key.pem

# --- Durable S3 store (region + addressing; endpoint/bucket/creds come from compose environment) ---
TUNNELD_S_3_REGION=us-east-1
TUNNELD_S_3_FORCE_PATH_STYLE=true

# --- Android hardware key-attestation gate ---
# Hot-reloadable allowlist of accepted app signing-cert SHA-256 digests (one hex digest per line).
TUNNELD_ATTEST_SIGNER_DIGEST_FILE=/attest/signers.txt

# --- ACME (server-run issuance for the phone's WebPKI cert: LE → GTS → ZeroSSL) ---
TUNNELD_ACME_EMAIL=ops@example.test
TUNNELD_ACME_ACCOUNT_DIR=/acme
# lego DNS-01 provider id (e.g. cloudflare, route53). The provider reads ITS OWN credential env vars per
# lego's conventions — set them below (example: Cloudflare). CAA guidance: publish three `issue` records
# (letsencrypt.org incl. accounturi/validationmethods, pki.goog, sectigo.com) as an operator DNS step.
TUNNELD_ACME_DNS_PROVIDER=cloudflare
CF_DNS_API_TOKEN=changeme
# GTS / ZeroSSL External Account Binding (optional; leave empty to use LE only until configured).
TUNNELD_ACME_EAB_GTS_KID=
TUNNELD_ACME_EAB_GTS_HMAC=
TUNNELD_ACME_EAB_ZEROSSL_KID=
TUNNELD_ACME_EAB_ZEROSSL_HMAC=

# --- Abuse controls: ban files + DB-IP geo CSV (produced by the fetcher service) ---
TUNNELD_BAN_FILE=/banfiles-manual/bans.txt,/banfiles/droplist.bans
TUNNELD_DBIP_COUNTRY_LITE_CSV=/banfiles/dbip-country-lite.csv

# --- Logging (composite sinks: split-severity stdout + a rotated file) ---
TUNNELD_LOG=output=std;level=info,output=/logs/tunneld.log;level=info;maxsize=50m;maxfiles=20
